{
  "name": "campustrade-dbms-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:postgres:migrate": "node --env-file=.env.local scripts/db/postgres-migrate.mjs",
    "db:postgres:seed": "node --env-file=.env.local scripts/db/postgres-seed.mjs",
    "db:postgres:test": "node --env-file=.env.local scripts/db/postgres-test.mjs",
    "db:mongodb:setup": "node --env-file=.env.local scripts/db/mongodb-setup.mjs",
    "db:mongodb:seed": "node --env-file=.env.local scripts/db/mongodb-seed.mjs",
    "db:mongodb:test": "node --env-file=.env.local scripts/db/mongodb-test.mjs",
    "auth:test": "node --env-file=.env.local scripts/auth-test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "mongodb": "^6.10.0",
    "next": "^16.0.0",
    "pg": "^8.13.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "typescript": "^5.7.0"
  }
}
